# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Docker, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/dental_clinic?schema=public"
# Direct/unpooled connection for Prisma Migrate (falls back to DATABASE_URL if omitted).
DIRECT_DATABASE_URL=""

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Do NOT set NEXTAUTH_URL/AUTH_URL — Auth.js infers the origin from the request
# (trustHost: true). Setting it (even just locally) gets picked up during `vercel deploy`
# and will hardcode every redirect to that value in production.

# ── Cloudinary (media storage) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="911234567890"

# ── Analytics ───────────────────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=""

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel injects this automatically for Cron Job invocations; set it yourself for manual testing.
CRON_SECRET=""

# ── Seed (initial super admin) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@dentalclinic.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
