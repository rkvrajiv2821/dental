generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  CONTENT_MANAGER
  RECEPTION
  SEO_MANAGER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AppointmentStatus {
  NEW
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  EXTERNAL
  UPLOADED
}

enum NavLocation {
  HEADER
  FOOTER
}

enum SectionType {
  HERO_SLIDER
  STATISTICS
  TEXT_IMAGE
  TREATMENTS
  DOCTORS
  TESTIMONIALS
  GALLERY
  VIDEO
  PARALLAX_IMAGE
  THREE_D
  FAQ
  CTA
  BLOG
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CONTENT_MANAGER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts BlogPost[]
  media     Media[]
  auditLogs AuditLog[]

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// HOMEPAGE / SLIDER / SECTION BUILDER / NAVIGATION / SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Slider {
  id               String    @id @default(cuid())
  title            String
  subtitle         String?
  desktopImage     String
  mobileImage      String?
  backgroundVideo  String?
  overlay          Boolean   @default(true)
  ctaText          String?
  ctaUrl           String?
  ctaText2         String?
  ctaUrl2          String?
  textPosition     String    @default("left")
  order            Int       @default(0)
  isActive         Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive, order])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  sections        PageSection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PageSection {
  id        String      @id @default(cuid())
  pageId    String
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  title     String?
  subtitle  String?
  content   Json        @default("{}")
  order     Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([pageId, order])
}

model Navigation {
  id           String       @id @default(cuid())
  label        String
  url          String
  order        Int          @default(0)
  location     NavLocation  @default(HEADER)
  openInNewTab Boolean      @default(false)
  isActive     Boolean      @default(true)
  parentId     String?
  parent       Navigation?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Navigation[] @relation("NavChildren")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([location, order])
}

model SiteSettings {
  id                String   @id @default(cuid())
  clinicName        String   @default("Dental Clinic")
  tagline           String?
  logoUrl           String?
  faviconUrl        String?
  addressLine       String?
  phone             String?
  email             String?
  whatsappNumber    String?
  whatsappMessage   String?  @default("Hello! I would like to book an appointment.")
  whatsappEnabled   Boolean  @default(true)
  whatsappPosition  String   @default("bottom-right")
  openingHours      Json?
  socialLinks       Json?
  googleMapsEmbed   String?
  footerText        String?
  googleAnalyticsId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SEOSettings {
  id                 String   @id @default(cuid())
  defaultTitle       String   @default("Premium Dental Clinic")
  titleTemplate      String   @default("%s | Premium Dental Clinic")
  defaultDescription String?
  defaultOgImage     String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  gscVerification    String?
  bingVerification   String?
  schemaBusinessType String   @default("Dentist")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// TREATMENTS
// ─────────────────────────────────────────────────────────────────────────

model TreatmentCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  order       Int         @default(0)
  treatments  Treatment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Treatment {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  categoryId       String?
  category         TreatmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription String?
  fullDescription  String?
  heroImage        String?
  gallery          String[]          @default([])
  benefits         Json              @default("[]")
  procedureSteps   Json              @default("[]")
  technologies     Technology[]
  faqs             FAQ[]
  doctors          DoctorTreatment[]
  smileCases       SmileCase[]
  testimonials     Testimonial[]
  appointments     Appointment[]
  relatedTo        Treatment[]       @relation("RelatedTreatments")
  relatedFrom      Treatment[]       @relation("RelatedTreatments")
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  status           ContentStatus     @default(DRAFT)
  order            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, order])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────
// DOCTORS
// ─────────────────────────────────────────────────────────────────────────

model DoctorSpecialization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  doctors   Doctor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  designation        String?
  specializationId   String?
  specialization     DoctorSpecialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  qualification      String?
  experienceYears     Int?
  profilePhoto       String?
  bio                String?
  languages          String[]              @default([])
  registrationNumber String?
  socialLinks        Json?
  availableDays      String[]              @default([])
  availableTime      String?
  treatments         DoctorTreatment[]
  testimonials       Testimonial[]
  appointments       Appointment[]
  seoTitle           String?
  seoDescription     String?
  status             ContentStatus         @default(DRAFT)
  order              Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, order])
}

model DoctorTreatment {
  doctorId    String
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@id([doctorId, treatmentId])
}

// ─────────────────────────────────────────────────────────────────────────
// TESTIMONIALS
// ─────────────────────────────────────────────────────────────────────────

model Testimonial {
  id          String        @id @default(cuid())
  patientName String
  photo       String?
  rating      Int           @default(5)
  review      String
  treatmentId String?
  treatment   Treatment?    @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  doctorId    String?
  doctor      Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  date        DateTime      @default(now())
  videoUrl    String?
  featured    Boolean       @default(false)
  status      ContentStatus @default(PUBLISHED)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, featured, order])
}

// ─────────────────────────────────────────────────────────────────────────
// GALLERY / SMILE CASES
// ─────────────────────────────────────────────────────────────────────────

model GalleryCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  items     Gallery[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Gallery {
  id         String           @id @default(cuid())
  title      String?
  image      String
  categoryId String?
  category   GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order      Int              @default(0)
  status     ContentStatus    @default(PUBLISHED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, order])
}

model SmileCase {
  id          String        @id @default(cuid())
  title       String
  caseId      String        @unique
  beforeImage String
  afterImage  String
  treatmentId String?
  treatment   Treatment?    @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  category    String?
  description String?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

// ─────────────────────────────────────────────────────────────────────────
// TECHNOLOGY / VIDEOS / FAQ
// ─────────────────────────────────────────────────────────────────────────

model Technology {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  image       String?
  icon        String?
  videoUrl    String?
  treatments  Treatment[]
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  provider    VideoProvider @default(YOUTUBE)
  url         String
  thumbnail   String?
  description String?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

model FAQ {
  id          String        @id @default(cuid())
  question    String
  answer      String
  category    String        @default("general")
  treatmentId String?
  treatment   Treatment?    @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category, order])
}

// ─────────────────────────────────────────────────────────────────────────
// BLOG
// ─────────────────────────────────────────────────────────────────────────

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String?
  featuredImage  String?
  content        String
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           BlogTag[]
  status         BlogStatus   @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  views          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────
// MEDIA LIBRARY
// ─────────────────────────────────────────────────────────────────────────

model Media {
  id           String    @id @default(cuid())
  filename     String
  url          String
  publicId     String?
  type         MediaType @default(IMAGE)
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  altText      String?
  folder       String?   @default("general")
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type, folder])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// APPOINTMENTS / ENQUIRIES
// ─────────────────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  name           String
  phone          String
  email          String?
  treatmentId    String?
  treatment      Treatment?        @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  doctorId       String?
  doctor         Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  preferredDate  DateTime?
  preferredTime  String?
  message        String?
  status         AppointmentStatus @default(NEW)
  notes          String?
  source         String?           @default("website")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
}

model ContactEnquiry {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}
